generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum Unit {
  UN
  KG
  L
  ML
  M
  CX
  PC
  JG
}

// Category tells a part from a supply
enum PartSupplyCategory {
  PART
  SUPPLY
}

// ─── Catalog and stock ────────────────────────────────────────────────────────
// work_order_id is a loose UUID owned by the Work Order service: no foreign key.
// The CHECK (stock >= reserved_stock AND reserved_stock >= 0) on parts_supplies lives in raw SQL
// in the migration, because Prisma cannot declare it.

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @unique @db.VarChar(150)
  description      String?  @db.Text
  basePrice        Decimal  @map("base_price") @db.Decimal(10, 2)
  estimatedTimeMin Int      @default(60) @map("estimated_time_min")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("services")
}

model PartSupply {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @db.VarChar(150)
  description   String?            @db.Text
  sku           String             @unique @db.VarChar(60)
  partNumber    String?            @map("part_number") @db.VarChar(60)
  category      PartSupplyCategory
  unit          Unit               @default(UN)
  costPrice     Decimal            @map("cost_price") @db.Decimal(10, 2)
  salePrice     Decimal            @map("sale_price") @db.Decimal(10, 2)
  stock         Int                @default(0)
  minStock      Int                @default(0) @map("min_stock")
  reservedStock Int                @default(0) @map("reserved_stock")
  version       Int                @default(1)
  expiresAt     DateTime?          @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  stockMovements    StockMovement[]
  stockReservations StockReservation[]

  @@map("parts_supplies")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  partSupplyId String            @map("part_supply_id") @db.Uuid
  workOrderId  String?           @map("work_order_id") @db.Uuid
  type         StockMovementType
  quantity     Int
  reason       String?           @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  partSupply PartSupply @relation(fields: [partSupplyId], references: [id])

  @@index([partSupplyId, createdAt])
  @@index([workOrderId])
  @@map("stock_movements")
}

model StockReservation {
  id           String   @id @default(uuid()) @db.Uuid
  partSupplyId String   @map("part_supply_id") @db.Uuid
  workOrderId  String   @map("work_order_id") @db.Uuid
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  partSupply PartSupply @relation(fields: [partSupplyId], references: [id])

  @@index([partSupplyId])
  @@index([workOrderId])
  @@map("stock_reservations")
}

// ─── Outbox ───────────────────────────────────────────────────────────────────

model OutboxMessage {
  id           BigInt   @id @default(autoincrement())
  messageId    String   @unique @default(uuid()) @map("message_id") @db.Uuid
  type         String   @db.VarChar(64)
  workOrderId  String?  @map("work_order_id") @db.Uuid
  payload      Json
  traceContext Json     @default("{}") @map("trace_context")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("outbox")
}
